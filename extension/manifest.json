{
  "manifest_version": 3,
  "name": "TradeSea One Trade",
  "version": "2.2.1",
  "minimum_chrome_version": "120",
  "description": "One completed trade, then an eight-hour TradeSea account lockout in your regular browser.",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://app.tradesea.ai/*",
    "https://prod-identity.tradesea.ai/*",
    "https://prod-trade-read.tradesea.ai/*",
    "https://api-trades-r-delprod.tradesea.ai/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "TradeSea One Trade",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.tradesea.ai/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://app.tradesea.ai/*"
      ],
      "js": [
        "observe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "incognito": "not_allowed",
  "key": ""
}
